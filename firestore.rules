rules_version = '2';

// Plan B Wholesale — Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// ── The whole data model, in one paragraph ────────────────────────────────────
//
// Three collections. `frames` is the catalogue — world-readable, staff-writable.
// `users` is a self-owned profile written on sign-in, which grants nothing.
// `admins` is the allowlist, readable by the person it names and writable only
// by someone who is already an admin.
//
// Orders are absent on purpose: a wholesale order lives in the buyer's own
// browser and leaves over Telegram or Viber, so there is no order collection and
// nothing a client could tamper with.
//
// ── Why permissions are not a field on the user document ─────────────────────
//
// A user must be able to write their own profile. If the same document also
// carried `role`, then "may write their own document" and "may not grant
// themselves the catalogue" become one rule that has to be right about every
// field forever. Splitting them means `users` can be permissive and `admins` can
// be near-immutable, and neither has to know about the other.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ─────────────────────────────────────────────────────────── */

    function isSignedIn() {
      return request.auth != null;
    }

    // ⚠️ Mirror of BOOTSTRAP_ADMIN_EMAILS in src/config/admins.ts.
    // Security rules cannot import TypeScript, so this list is duplicated in
    // three places: there, here, and storage.rules. Change one, change all three
    // — and remember Firestore and Storage are separate deploys.
    //
    // `email_verified` is required. Without it, anyone could register an
    // email/password account claiming this address and inherit the catalogue.
    // Google sign-in sets the flag automatically; email/password sets it only
    // after the emailed link is clicked.
    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'kyawwinhtun56@gmail.com',
             'kyawwinhtun564@gmail.com'
           ];
    }

    // Staff are listed by uid in `admins/{uid}`. An allowlist collection rather
    // than a custom claim because claims need the Admin SDK to set, which would
    // mean a service-account key on someone's laptop; a document can be created
    // from the admin page and revoked just as fast.
    //
    // The document's contents are irrelevant — existence is the grant.
    function isAdmin() {
      return isBootstrapAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    /* ── users/{uid} — who has signed in ─────────────────────────────────── */
    //
    // Written by `lib/firestore/users.ts` on each new session. Any Google account
    // may create and maintain its **own** document and read nothing else.
    //
    // `list` is denied: a queryable users collection is an email directory for
    // every buyer the shop has, and nothing in the app needs to enumerate it.
    //
    // The `uid` field is pinned to the document id so a record cannot be written
    // claiming to be somebody else, and the writable fields are enumerated so
    // this document can never grow a `role` or `isAdmin` that some future rule
    // might be tempted to trust. Admin status lives in `admins/{uid}` only.

    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'photoURL', 'emailVerified', 'lastSignInAt'
           ]);

      // Account deletion is a support conversation, not a client operation.
      allow delete: if false;

      /* ── users/{uid}/orders/{reference} — the buyer's own history ─────── */
      //
      // Nested under the owner, so ownership is the path rather than a field
      // that has to be checked — there is no way to address someone else's
      // order at all.
      //
      // `list` is allowed here, unlike on `users` itself: a buyer must be able
      // to page their own history, and the collection is already scoped to them.
      //
      // Deliberately **not** validated field by field. This is the buyer's own
      // record of what they sent; the shop's authoritative copy is the Telegram
      // message. Constraining the shape here would mean editing the rules every
      // time the voucher gains a line, for a document only its owner can read.

      match /orders/{reference} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    /* ── admins/{uid} ────────────────────────────────────────────────────── */
    //
    // Readable by the signed-in staff member it names, so the app can show or
    // hide admin tools. Never writable by a buyer — a client that could create
    // its own entry here would be able to grant itself the catalogue.

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;

      // An existing admin may grant staff access, including the bootstrap owner
      // promoting their own account so the record persists beyond the email list.
      // `uid == request.auth.uid` is NOT required, so an admin can add a
      // colleague by uid — but only an admin can, which is the point.
      allow create: if isAdmin();

      // Deletion is deliberately excluded. Revoking access is a decision that
      // should be made in the console with a moment's thought, not one click away
      // from an admin who could otherwise lock everyone out, themselves included.
      allow update, delete: if false;
    }

    /* ── frames/{frameId} — the catalogue ────────────────────────────────── */
    //
    // Public read: buyers browse without an account, by design — the app has no
    // buyer sign-in at all. Nothing here is sensitive beyond the trade price,
    // which is on the price list every stockist already holds.
    //
    // If trade prices must not be public, the fix is a buyer login and a rule
    // requiring it — not obscurity in the client, which stops nobody.
    //
    // Writes are staff-only. Field validation is intentionally light because the
    // upload form is the only writer and `normalizeFrame` in
    // `lib/firestore/frames.ts` already defends every read; duplicating the full
    // schema here would mean two places to update for every new attribute.

    match /frames/{frameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ── creditShops/{id}, creditOrders/{id} — the wholesale credit ledger ── */
    //
    // Staff-only, full stop: no public read, unlike `frames`. A shop's credit
    // limit and running balance are not information a catalogue browser has any
    // reason to see, and unlike the catalogue there is no "buyer view" of this
    // data at all — a shop's own copy of a voucher is the message they were
    // sent over Telegram, not a page they sign in and read.
    //
    // Field validation is intentionally light, same reasoning as `frames`: the
    // admin credit page is the only writer, and `lib/firestore/credit.ts`
    // already normalises every read defensively. `creditOrders` additionally
    // denies `update` outright — a saved voucher is a record of what was agreed
    // with a shop, and letting it be edited after the fact would mean the
    // number a shop was quoted and the number in the ledger could silently
    // diverge. Only `delete` is allowed, for removing a mistaken entry, and
    // deleting is a deliberate, visible act rather than the kind of quiet edit
    // a stale-looking record invites.

    match /creditShops/{shopId} {
      allow read, write: if isAdmin();
    }

    match /creditOrders/{orderId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    /* ── Everything else ─────────────────────────────────────────────────── */
    //
    // Denied by default, including the retail collections this app used to have
    // (`members`, `memberIndex`, `appointments`, `reviews`). Leaving their rules
    // in place after the features were deleted would keep granting access to data
    // nothing writes and nobody reads — an attack surface with no upside.
    //
    // Note this also covers `admins` *listing* and any collection added later:
    // a new feature has to add its rule deliberately rather than inherit one.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
