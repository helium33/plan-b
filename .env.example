# ---------------------------------------------------------------------------
# Plan B Vision — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# Every variable MUST be prefixed with VITE_ to be exposed to the client.
# ---------------------------------------------------------------------------

# Firebase (Web SDK). These values are public identifiers, not secrets —
# real protection comes from Firestore/Storage security rules + App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Point the SDK at the local Firebase emulator suite during development.
VITE_USE_FIREBASE_EMULATORS=false

# Telegram handle used by the "Buy via Telegram" checkout flow (no @ prefix).
VITE_TELEGRAM_HANDLE=planbvision

# Brand contact details surfaced in the footer / store locator.
VITE_STORE_PHONE=+95 9 000 000 000
VITE_STORE_EMAIL=hello@planbvision.com
