# ---------------------------------------------------------------------------
# Plan B Wholesale — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# Every variable MUST be prefixed with VITE_ to be exposed to the client.
# ---------------------------------------------------------------------------

# Firebase (Web SDK). These values are public identifiers, not secrets —
# real protection comes from Firestore/Storage security rules + App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Point the SDK at the local Firebase emulator suite during development.
VITE_USE_FIREBASE_EMULATORS=false

# Show the built-in demo catalogue instead of reading Firestore. Use this to try
# the ordering flow before setting up a Firebase project. Never set it on a real
# deployment — a live site quietly serving sample frames is worse than one that
# shows an error.
VITE_USE_SAMPLE_CATALOGUE=false

# Where finished orders are sent. Handle only — no @ prefix.
VITE_TELEGRAM_HANDLE=planbvision

# Shown beside the Viber button so a buyer can save the number.
VITE_VIBER_NUMBER=+95 9 000 000 000

# The "How to Use" clip played on first launch. Optional: with no URL the
# onboarding modal shows an illustrated three-step walkthrough instead, which
# is preferable to a <video> element pointed at nothing.
VITE_ONBOARDING_VIDEO_URL=
VITE_ONBOARDING_POSTER_URL=
