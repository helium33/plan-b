rules_version = '2';

// Plan B Wholesale — Firebase Storage security rules.
//
// Deploy with:  firebase deploy --only storage
//
// ── This bucket is read-only, and that is the whole ruleset ──────────────────
//
// Catalogue media moved to Cloudinary (see `src/lib/media/upload.ts`), so
// nothing in the app writes here any more. Frames uploaded before that move
// still hold `firebasestorage.googleapis.com` URLs in their `images` arrays, so
// reads must keep working or an old frame's photos would break — but every write
// path is closed.
//
// Storage rules are a **separate ruleset from Firestore's** and are deployed by a
// separate command. Deploying `firestore.rules` alone leaves this bucket on its
// defaults, and the default in a new project allows any signed-in user to write
// anywhere — which, now that any Google account can sign in, would mean handing
// free file hosting to the internet. That is precisely why this file still
// exists rather than being deleted along with the upload path.

service firebase.storage {
  match /b/{bucket}/o {

    /* ── frames/… — legacy catalogue media ───────────────────────────────── */
    //
    // Public read, no write. Nothing here is sensitive: it is the same imagery
    // served publicly from Cloudinary today.

    match /frames/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    /* ── Everything else ─────────────────────────────────────────────────── */
    //
    // Denied outright, including the retail build's `reviews/{uid}/…` path. A
    // write path with no feature behind it is an open bucket waiting to be found.

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
